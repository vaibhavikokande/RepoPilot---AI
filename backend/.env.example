# RepoPilot AI — Backend Environment Variables
# Copy this file to .env and fill in the values

# Application
DEBUG=true

# OpenAI
OPENAI_API_KEY=

# GitHub
GITHUB_TOKEN=

# Database (PostgreSQL + pgvector)
DATABASE_URL=postgresql://user:password@localhost:5432/repopilot

# Redis
REDIS_URL=redis://localhost:6379/0

# CORS
ALLOWED_ORIGINS=["http://localhost:3000"]

# Embedding & Vector Store (Day 5)
# Options for EMBEDDING_PROVIDER: local, openai, mock
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_API_KEY=
EMBEDDING_BATCH_SIZE=32
CHROMA_PERSIST_DIR=chroma_db

# LLM & RAG (Day 6)
# Options for LLM_PROVIDER: openai, mock
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_MAX_OUTPUT_TOKENS=1024
RAG_TOP_K=5

